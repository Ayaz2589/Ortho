# Ortho monorepo — root ignores.
# The app subdirectories keep their own .gitignore files (web/.gitignore,
# iOS/.gitignore, supabase/.gitignore); git honors those too. This file
# covers root-level and cross-cutting concerns only.

# OS cruft
.DS_Store
**/.DS_Store

# Local scratch / screenshots
temp/

# Local CI setup & usage guide — holds credential values for sandboxes. NEVER commit.
/CI-SETUP.local.md

# Host-side secrets for sandbox bootstrap (e.g. a GitHub token). NEVER commit — a
# leaked push token compromises the repo. Keep host-side only; the tracked
# `.secrets.example` is the placeholder template.
/.secrets
/.secrets.*
!/.secrets.example

# Pre-monorepo git histories — preserved locally, NOT tracked.
# Recover with e.g.:  git --git-dir=.history-backup/ortho-web.git log
.history-backup/

# Local agent settings (keep skills + .specify tracked; ignore machine-local prefs)
.claude/settings.local.json

# Per-session context summaries written by the clear-context skill — local
# artifacts, not repo history. Force-add a specific one with `git add -f` if
# you ever want to keep it.
.claude/context-summaries/

# Safety nets (the app subdirs also ignore these via their own .gitignore)
**/node_modules/
web/.next/
web/tsconfig.tsbuildinfo

# Stray dir recreated by a dev server still running in the pre-rename path.
# Stop that server and restart from web/.
Ortho-web/
